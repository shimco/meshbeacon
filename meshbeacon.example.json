{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "advertise_addr": "auto",
  "cache": {
    "enabled": true,
    "ram_size": "auto",
    "disk_dir": "",
    "disk_size": "auto",
    "ttl": "auto"
  },
  "services": [
    {
      "name": "jellyfin",
      "local_port": 8096,
      "upstream_url": "http://mediaserver.your-tailnet.ts.net:8096",
      "discovery": {
        "type": "jellyfin",
        "port": 7359,
        "server_name": "Living Room Jellyfin",
        "server_id": ""
      }
    },
    {
      "name": "plex",
      "local_port": 32400,
      "upstream_url": "http://mediaserver.your-tailnet.ts.net:32400",
      "discovery": {
        "type": "plex",
        "port": 32414,
        "server_name": "Living Room Plex",
        "server_id": ""
      }
    },
    {
      "name": "immich",
      "local_port": 2283,
      "upstream_url": "http://photos.your-tailnet.ts.net:2283",
      "discovery": {
        "type": "immich",
        "service": "_immich._tcp",
        "server_name": "Home Photos",
        "txt": {
          "path": "/api"
        }
      }
    },
    {
      "name": "office-printer",
      "local_port": 631,
      "upstream_url": "http://cups.your-tailnet.ts.net:631",
      "discovery": {
        "type": "mdns",
        "service": "_ipp._tcp",
        "server_name": "Office Laser Printer",
        "txt": {
          "rp": "printers/OfficeLaser",
          "pdl": "application/pdf,image/urf"
        }
      }
    }
  ]
}
